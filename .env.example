# AxyRouter / Axynity
# Never commit real production secrets to GitHub.

AXY_CONFIG={"name":"Axynity","developer":"Axynera","version":"1.0.0","defaultModel":"Axynity-M1","website":"https://github.com/axynera/axyrouter"}

# Client/gateway API key
AXY_KEYS=["Axy-your-client-api-key"]

# Generic backend provider. Replace these with your real values.
AXY_PROVIDER_DEFAULT_BASE_URL=https://your-provider.example/v1
AXY_PROVIDER_DEFAULT_KEY_1=YOUR_PROVIDER_API_KEY

# Add more providers/keys without changing source code:
# AXY_PROVIDER_PROVIDER_2_BASE_URL=https://another-provider.example/v1
# AXY_PROVIDER_PROVIDER_2_KEY_1=YOUR_PROVIDER_API_KEY
# AXY_PROVIDER_PROVIDER_2_KEY_2=YOUR_PROVIDER_API_KEY

AXY_MODELS={"Axynity-M1":{"name":"Axynity-M1","displayName":"Axynity","provider":"default","model":"YOUR_BACKEND_MODEL","credentials":[0],"autoContinue":true,"maxContinue":5}}

AXY_AUTO_CONTINUE={"enabled":true,"maxRounds":3,"prompt":"Continue exactly from where you stopped. Do not repeat previous content."}
AXY_HEARTBEAT={"enabled":true,"interval":30000}
