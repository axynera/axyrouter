# AxyRouter local configuration
# Never commit real secrets.

AXY_CONFIG={"name":"Axynera AI","developer":"Axynera","version":"1.0.0","defaultModel":"Axynity"}

# Optional gateway/client API keys:
AXY_KEYS=["Axy-client-key-1"]

# Optional global behavior:
AXY_AUTO_CONTINUE={"enabled":true,"maxRounds":3,"prompt":"Continue exactly from where you stopped. Do not repeat previous content."}
AXY_HEARTBEAT={"enabled":true,"interval":30000}

# Providers are completely generic.
# Add as many providers and credentials as needed.
# The provider name is the part after AXY_PROVIDER_.
#
# Example provider "PROVIDER_A":
# AXY_PROVIDER_PROVIDER_A_BASE_URL=https://provider-a.example/v1
# AXY_PROVIDER_PROVIDER_A_KEY_1=your-secret-key
# AXY_PROVIDER_PROVIDER_A_KEY_2=your-secret-key
#
# Example provider "PROVIDER_B":
# AXY_PROVIDER_PROVIDER_B_BASE_URL=https://provider-b.example/v1
# AXY_PROVIDER_PROVIDER_B_KEY_1=your-secret-key
#
# No provider is hardcoded into the router.

# Public model aliases map to any configured provider/backend model.
# Backend provider/model names stay hidden from clients.
AXY_MODELS={"Axynity X-Dev":{"name":"Axynity X-Dev","provider":"PROVIDER_A","model":"backend-model","credentials":[0,1],"autoContinue":true,"maxContinue":5},"Axynity":{"name":"Axynity","provider":"PROVIDER_B","model":"backend-model"}}
