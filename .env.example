# AxyRouter local configuration
# Never commit real secrets.

AXY_CONFIG={"name":"Axynera AI","developer":"Axynera","version":"1.0.0","defaultModel":"Axynity"}
AXY_PROVIDERS={"deepseek":{"baseUrl":"https://api.deepseek.com/v1","credentials":[]}}
AXY_MODELS={"Axynity X-Dev":{"name":"Axynity X-Dev","provider":"deepseek","model":"deepseek-chat","autoContinue":true,"maxContinue":5}}
AXY_AUTO_CONTINUE={"enabled":true,"maxRounds":3,"prompt":"Continue exactly from where you stopped. Do not repeat previous content."}
AXY_HEARTBEAT={"enabled":true,"interval":30000}
AXY_KEYS=["Axy-client-key-1"]

# Provider keys can be added automatically without putting them in AXY_PROVIDERS JSON:
# AXY_PROVIDER_DEEPSEEK_KEY_1=your-secret-key
# AXY_PROVIDER_DEEPSEEK_KEY_2=your-secret-key
